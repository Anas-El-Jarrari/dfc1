# Copy this file to .env.local. Never commit credentials.
APP_URL=http://localhost:3000
DATABASE_URL=file:.data/openmind.db
# DATABASE_AUTH_TOKEN=

# Local models only; no Gemini/OpenAI/Anthropic key is used.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_ENABLED=true
SEARXNG_URL=http://127.0.0.1:8080

# Gmail OAuth: create your own Web application client in Google Cloud.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/mail/oauth/callback
# Exactly 32 random bytes encoded as Base64. Keep stable to decrypt stored tokens.
GMAIL_TOKEN_KEY=

# Login links ONLY. This setting never affects outgoing user submissions.
# console exposes a development login link locally; use smtp for public hosting.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenMind <login@example.org>

